{
  "name": "add-to-claude",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Menu-bar ChatGPT panel that adds the open conversation to an existing composer window, without sending.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "build:webkit": "node scripts/build-webkit.js",
    "test:native": "bash scripts/test-native.sh",
    "build:macos": "bash scripts/build-macos.sh",
    "check": "npm test && npm run test:browser && npm run test:native",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2"
  },
  "license": "MIT"
}
